# Copy this file to .env and fill in your own values.
# .env is never shared or uploaded anywhere — it just lives on your computer.

# ---- Required: lets the script cluster the open-text questions ----
# Get this from https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=

# ---- Optional: only needed if you want images auto-uploaded to Notion ----
# Leave both blank to skip the Notion step entirely — the script will
# still create the HTML, PDF, and PNG files either way.
# See SETUP_GUIDE.md for how to get these two values.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Only change this if you renamed your database's title column away from "Name"
NOTION_TITLE_PROPERTY=Name

# ---- Optional: event details shown in the dashboard header ----
EVENT_NAME=MAP Connect
EVENT_DATE=

# ---- Optional: override the default AI model ----
CLAUDE_MODEL=claude-sonnet-5
